# Org-specific values for the Northwind Service Agent build.
#
# Copy this file to config/org-values.local.env (git ignores *.local.env), replace each
# __NAME__ placeholder, and load it into your shell before running the scripts or the
# runbook commands:
#
#   set -a; . config/org-values.local.env; set +a
#
# The scripts stop while EXPECTED_ORG_ID or SITE_DOMAIN still holds a placeholder.

# Salesforce CLI alias of the target org (sf org login web -a northwind-dev)
ORG_ALIAS=northwind-dev

# The same alias, under the name setup-data-library.sh and setup-agent-user.sh read
TARGET_ORG="${ORG_ALIAS}"

# 15- or 18-character org ID from sf org display; the scripts refuse to run against another org
EXPECTED_ORG_ID=__ORG_ID__

# My Domain name: the host of the org URL without .my.salesforce.com, for example acme-dev-ed.develop.
# Replaces __MY_DOMAIN__ in force-app/main/default/cspTrustedSites and corsWhitelistOrigins (runbook step 7)
MY_DOMAIN=__MY_DOMAIN__

# Experience Cloud site domain used by create-portal.sh
SITE_DOMAIN="https://${MY_DOMAIN}.my.site.com"

# Retriever API name from Prompt Builder, for example File_Northwind_Home_Docs_1Cx_<hash>.
# Leave empty until the data library exists (runbook step 2)
RETRIEVER_API_NAME=

# Agent user username, the last line printed by scripts/setup-agent-user.sh.
# Replaces __AGENT_USER_USERNAME__ in Northwind_Service_Agent.agent (runbook step 10)
AGENT_USER_USERNAME=
